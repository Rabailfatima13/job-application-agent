# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Model providers (the proposal requires at least two) ---------------
# Primary provider, used for the "heavy" steps (scoring, writing).
# Default: Anthropic.
ANTHROPIC_API_KEY=
HEAVY_PROVIDER=anthropic
HEAVY_MODEL=claude-sonnet-5

# To route the heavy tier to any OpenAI-compatible provider instead (e.g.
# Google's Gemini via its OpenAI-compatible endpoint), set HEAVY_PROVIDER to
# "openai_compatible" and fill these in - HEAVY_API_KEY takes priority over
# ANTHROPIC_API_KEY when both are set, and Anthropic is never called in that
# case:
#   HEAVY_PROVIDER=openai_compatible
#   HEAVY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   HEAVY_API_KEY=
#   HEAVY_MODEL=

# Secondary provider, used for the "light" steps (CV/JD parsing, summarising).
# Any OpenAI-compatible endpoint works - pick ONE and set its base URL + key:
#   Groq     -> https://api.groq.com/openai/v1        (LIGHT_MODEL=llama-3.3-70b-versatile)
#   Ollama   -> http://localhost:11434/v1             (LIGHT_MODEL=llama3, LIGHT_API_KEY=ollama)
#   OpenRouter -> https://openrouter.ai/api/v1        (LIGHT_MODEL=meta-llama/llama-3.3-70b-instruct)
LIGHT_PROVIDER=openai_compatible
LIGHT_BASE_URL=https://api.groq.com/openai/v1
LIGHT_API_KEY=
LIGHT_MODEL=llama-3.3-70b-versatile

# --- Web search (research agent) ---------------------------------------
# SEARCH_PROVIDER: serpapi | brave
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=

# --- Storage ------------------------------------------------------------
# SQLite file holding the application tracker; survives restarts.
TRACKER_DB_PATH=data/applications.db

# --- Tracing (local trace log; always on, no key needed) ----------------
TOOL_CALL_LOG_PATH=data/tool_calls.log
